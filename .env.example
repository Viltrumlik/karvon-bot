# Token from @BotFather (required for the real Telegram bot)
BOT_TOKEN=123456789:replace-with-your-token
# Optional: custom Bot API server base URL (local server, tests, console client)
# TELEGRAM_API_BASE=http://127.0.0.1:8081
# Optional: SQLite database file (default ./karvon.db)
DB_PATH=karvon.db
